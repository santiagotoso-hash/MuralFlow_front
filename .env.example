# URL da API (back). Em produção, a URL pública do serviço.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Opcionais. Na Vercel, ficam no projeto do front (e pedem Redeploy).

# Nome no cabeçalho do recibo em PDF quando a sessão não traz a escola (o recibo
# usa o nome da escola de quem está logado). Vazio = "MuralFlow".
NEXT_PUBLIC_ESCOLA_NOME=

# Contato comercial da tela inicial ("Falar no WhatsApp" e "mande um e-mail").
# WhatsApp com o código do país e o DDD, só números ou com pontuação: 55 71 99999-1778.
# Vazios = os contatos padrão do MuralFlow.
NEXT_PUBLIC_CONTATO_WHATSAPP=
NEXT_PUBLIC_CONTATO_EMAIL=
